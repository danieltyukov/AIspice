.aispice-sch .hl-removed .hl-box{fill:var(--sch-removed-bg, rgba(197,48,48,0.12))}
.aispice-sch .hl-changed .body{stroke:var(--sch-changed, #b7791f)}
.aispice-sch .hl-changed .attr,.aispice-sch .hl-changed .sym-text,.aispice-sch .hl-changed .fill{fill:var(--sch-changed, #b7791f)}
.aispice-sch .hl-changed .hl-box{fill:var(--sch-changed-bg, rgba(183,121,31,0.14))}
</style>
