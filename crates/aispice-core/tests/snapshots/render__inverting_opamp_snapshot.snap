.aispice-sch .hl-box{fill:none;stroke:none}
.aispice-sch .hl-added .body{stroke:var(--sch-added, #2f855a)}
.aispice-sch .hl-added .attr,.aispice-sch .hl-added .sym-text,.aispice-sch .hl-added .fill{fill:var(--sch-added, #2f855a)}
